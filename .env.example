# Local multi-tenant dev for cc-screen-hub (proposal 0001). Copy to `.env` (which
# is gitignored) and fill in real values. Load with:  set -a; . ./.env; set +a
# Multi-tenant requires a build with `--features multi-tenant`.

# Database URL → enables multi-tenant mode. SQLite first (Postgres backend later).
CCHUB_DATABASE_URL=sqlite:///var/lib/cc-screen-hub/hub.db

# Google "Sign in with Google" (Authorization Code + PKCE, exchanged server-side).
# Create OAuth credentials in the Google Cloud console and register the redirect
# URI  <CCHUB_PUBLIC_URL>/api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public origin the hub builds redirect/verification URIs against (no trailing /).
CCHUB_PUBLIC_URL=http://localhost:8840

# Summary metering. No billing — plans are set by hand (`cc-screen-hub user plan
# <email> <plan>`; defaults seeded: free/pro/unlimited); the hosted hub is free
# during beta. The hub holds the shared Anthropic key; cap per-tenant spend so
# one user can't drain it. CCHUB_SUMMARY_BUDGET is the fleet-wide cap (USD since
# start); _USER_BUDGET is the per-user cap. Both optional.
# CCHUB_SUMMARY_BUDGET=50
# CCHUB_SUMMARY_USER_BUDGET=2

# Optional support contact shown to users at plan-limit walls (proposal 0056).
# CCHUB_SUPPORT_EMAIL=support@example.com

# Invite email (optional; proposal 0073). Unset = the hub sends no mail and the
# copyable invite link stays the only channel. CCHUB_PUBLIC_URL above is required
# for it — without an absolute base the mailer stays off rather than mail a
# relative link. CCHUB_MAIL_REPLY_TO falls back to CCHUB_SUPPORT_EMAIL, and
# CCHUB_MAIL_DIR writes each message to a file instead of sending it (what the
# test harnesses use), taking precedence over CCHUB_SMTP_URL.
# CCHUB_SMTP_URL=smtp://user:key@smtp-relay.brevo.com:587
# CCHUB_MAIL_FROM=cc-screen <invites@ccscreen.dev>
# CCHUB_MAIL_REPLY_TO=you@example.com
# CCHUB_MAIL_DIR=/tmp/cc-screen-mail
