# Copy to `.env` and fill in. With all blank the hub runs with NO auth and an OPEN
# agent uplink — which is why the compose binds host LOOPBACK by default. To reach
# the hub off-box (set HUB_BIND to the tailnet IP in docker-compose.yml) you MUST
# set CCWEB_API_TOKEN and CCHUB_AGENT_TOKENS below, or the hub's fail-closed
# startup guard refuses to bind a routable address (last-resort overrides:
# CCWEB_ALLOW_UNAUTHENTICATED_REMOTE=1 / CCHUB_ALLOW_OPEN_UPLINK=1 — don't).
# Generate a token with:  openssl rand -hex 32
#
# Front a public/off-tailnet hub with a TLS reverse proxy and set
# CCWEB_ALLOWED_ORIGINS below so the browser Origin/Host check accepts it.

# ── Client auth gate (browser PWA + `ccs` TUI) ───────────────────────────────
# Set at least one to require a credential on every /api/ request.
#   CCWEB_API_TOKEN — the "API key": headless clients send it as
#                     `Authorization: Bearer <token>`; the web login accepts it too.
#   CCWEB_PASSWORD  — a web-login password (mints a 2-week cookie). Optional; the
#                     token alone is enough.
CCWEB_API_TOKEN=
CCWEB_PASSWORD=

# ── Per-agent uplink tokens (who may register as a machine) ───────────────────
# Comma-separated `machine:token` pairs. Empty = OPEN uplink (any agent may
# register). Set it so only known machines can join. This is a SEPARATE secret
# from the client gate above — a leaked client token can't impersonate an agent.
#
# Each machine host then dials in with:
#   cc-screen-rust ... --hub http://HUB:8840 --token <token> --machine-id <machine>
#
# Example (uncomment + edit):
# CCHUB_AGENT_TOKENS=pine:CHANGE-ME-pine,oak:CHANGE-ME-oak
CCHUB_AGENT_TOKENS=

# ── Reverse proxy / public hostname ──────────────────────────────────────────
# Comma-separated extra Origin/Host values the browser check accepts, for a hub
# fronted by a TLS reverse proxy or tunnel. List every public hostname clients
# use (e.g. CCWEB_ALLOWED_ORIGINS=app.example.com,hub.example.com).
CCWEB_ALLOWED_ORIGINS=

# ── Multi-tenant (SaaS) mode ─────────────────────────────────────────────────
# The shipped image is built with `--features multi-tenant`, but the capability
# is DORMANT until CCHUB_DATABASE_URL is set — without it the hub runs classic
# single-tenant, exactly as above. Set it and the hub becomes a multi-account
# service: public signup + Google sign-in, per-user machine enrollment via
# <hub>/activate, per-plan machine/session caps. No billing — plans are set by
# hand (`cc-screen-hub user plan <email> free|pro|unlimited`).
#
# Convention for the container: keep the SQLite file in the SAME volume that
# already persists the hub's state (hub-config → /home/app/.config/cc-screen-hub),
# so no extra mount is needed:
# CCHUB_DATABASE_URL=sqlite:///home/app/.config/cc-screen-hub/hub.db
CCHUB_DATABASE_URL=

# Canonical public origin (no trailing /). Baked into the served install
# one-liners (<hub>/install.sh|.ps1), the device flow's verification_uri
# (<hub>/activate), and the Google OAuth redirect. Unset = derived per request.
# CCHUB_PUBLIC_URL=https://app.example.com
CCHUB_PUBLIC_URL=

# Google "Sign in with Google" (optional). Create OAuth credentials in the
# Google Cloud console and register the redirect URI
#   <CCHUB_PUBLIC_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set to 1 to disable password signup/login entirely (Google sign-in only).
# CCHUB_OAUTH_ONLY=1

# Optional support contact shown to users at plan-limit walls (proposal 0056).
# CCHUB_SUPPORT_EMAIL=support@example.com

# Session summaries spend caps (USD since process start; needs an Anthropic key
# on the hub). Fleet-wide cap + per-user cap; both optional.
# CCHUB_SUMMARY_BUDGET=50
# CCHUB_SUMMARY_USER_BUDGET=2
